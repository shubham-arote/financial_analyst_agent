# Copy this file to ".env" and set ONE provider to turn on real VLM recognition
# (per-block vision OCR) + synthesized LLM answers. Both are free and OpenAI-compatible.
# With no key, the app still runs: local layout detection + the bundled sample's
# ground-truth text + extractive answers.

# Groq — fast, generous free tier:        https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — has free ":free" models:    https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Cohere — free tier: turns on the HybridRetriever's dense embeddings (embed-v4) +
# cross-encoder rerank (rerank-v3.5). With no key, retrieval falls back to BM25.
# Free key: https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=
# COHERE_EMBED_MODEL=embed-v4.0
# COHERE_RERANK_MODEL=rerank-v3.5

# Conversation memory (multi-turn follow-ups). Durable per-thread state via LangGraph.
# SRR_CHECKPOINT=sqlite      # sqlite (default, durable) | postgres | memory | off
# SRR_CHECKPOINT_DB=data/checkpoints.db                       # path for the sqlite checkpointer
# CHECKPOINT_DB_URL=postgresql://user:pass@host:5432/db       # postgres / Cloud SQL checkpointer

# Gold deploy: external Qdrant hybrid store (else in-memory). Needs qdrant-client + fastembed.
# SRR_VECTOR_STORE=memory    # memory (default) | qdrant
# QDRANT_MODE=local          # local (QDRANT_LOCATION) | cloud (QDRANT_URL + QDRANT_API_KEY)
# QDRANT_LOCATION=:memory:   # ":memory:" (in-process, no server) or a local URL
# QDRANT_URL=                # Qdrant Cloud cluster URL   (when QDRANT_MODE=cloud)
# QDRANT_API_KEY=            # Qdrant Cloud API key
# QDRANT_COLLECTION=srr_docs

# Stateless DocStore (else SQLite on the instance disk). Needs google-cloud-storage.
# SRR_DOCSTORE=sqlite        # sqlite (default) | gcs
# GCS_BUCKET=                # bucket for doc blobs + page JSON (when SRR_DOCSTORE=gcs)
# GCS_ENDPOINT=              # only for a local emulator (fake-gcs-server); leave unset on real GCS

# --- optional model overrides ---
# VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# TEXT_MODEL=llama-3.3-70b-versatile

# --- or any custom OpenAI-compatible endpoint (e.g. a local vLLM serving MonkeyOCR) ---
# VLM_BASE_URL=http://localhost:8000/v1
# VLM_API_KEY=EMPTY
# VLM_MODEL=echo840/MonkeyOCR

# --- pipeline knobs ---
# SRR_DETECTOR=heuristic       # or: doclayout   (needs `pip install doclayout-yolo`)
# SRR_RECOGNIZER=auto          # or: cloud | groundtruth | easyocr | stub
# SRR_STREAM_DELAY=0.12        # seconds between structure events (UI animation pacing)
# SRR_MAX_WORKERS=6            # recognition thread-pool size
# SRR_TABLES=1                 # 1 = detect ruled tables (find_tables); 0 = skip (faster)
# SRR_RERANK=heuristic         # reorder retrieval candidates: heuristic | llm | off
# SRR_PDF_PARSER=auto          # auto (scanned -> cloud OCR if key, else Docling) | docling | cloudvlm | textlayer
# SRR_DOCLING_OCR=             # unset = auto (OCR only scanned docs); 1 = always OCR; 0 = never (fastest)
# SRR_DOCLING_CHUNK=6          # pages parsed per background chunk (smaller = progress sooner)
# SRR_VLM_CHUNK=4              # pages per chunk for cloud VLM OCR (cloudvlm)
# SRR_DB=data/docs.db          # DocStore path (parsed docs survive restart; swap for GCS/Firestore on GCP)
